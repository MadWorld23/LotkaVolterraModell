<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LotkaVolterraAvalonia.MainWindow"
        Title="Lotka-Volterra Modell (C# Avalonia)"
        Width="1250" Height="750" WindowState="Normal">

    <Grid RowDefinitions="*,*,70" Margin="5">
        <!-- Zeit-Plot -->
        <Border Grid.Row="0" Background="White" BorderBrush="Gray" BorderThickness="1" Margin="2">
            <Canvas x:Name="TimeCanvas"/>
        </Border>

        <!-- Phasen-Plot -->
        <Border Grid.Row="1" Background="White" BorderBrush="Gray" BorderThickness="1" Margin="2">
            <Canvas x:Name="PhaseCanvas"/>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="1" Margin="2" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <Border Background="#F5DEB3" CornerRadius="5" Padding="10,5" MinWidth="200">
                    <TextBlock x:Name="InfoLabel" Text="Zeit: 0.0 | Hasen: 0 | Wölfe: 0"
                               FontFamily="Menlo,Consolas" FontSize="12" VerticalAlignment="Center"/>
                </Border>

                <Button x:Name="PlayButton" Content="Pause ⏸" Width="100" Height="30"
                        Click="OnPlayClick" Background="#FAFAD2"/>
                <Button x:Name="ResetButton" Content="Reset ↺" Width="100" Height="30"
                        Click="OnResetClick" Background="#F08080"/>

                <TextBlock Text="Speed:" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider x:Name="SpeedSlider" Minimum="1" Maximum="50" Value="5" Width="200"
                        ValueChanged="OnSpeedChanged"/>
                <TextBlock x:Name="SpeedLabel" Text="1.0x" VerticalAlignment="Center" FontWeight="Bold" Width="40"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>